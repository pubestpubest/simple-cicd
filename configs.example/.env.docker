# Application environment variables
# Copy this file to your app directory and customize
# This file is loaded by the web service via env_file in docker-compose.yml

NODE_ENV=production
PORT=4000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# For single-container setup (external database):
# DATABASE_URL=postgresql://user:pass@external-db-host:5432/mydb

# For multi-container setup (see docker-compose.multi-container.yml):
# DATABASE_URL is set in docker-compose.yml environment section
# It uses variables from .env file to construct the connection string

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# For single-container setup (external Redis):
# REDIS_URL=redis://external-redis-host:6379

# For multi-container setup:
# REDIS_URL is set in docker-compose.yml environment section

# =============================================================================
# API KEYS & SECRETS
# =============================================================================
# API_KEY=your-api-key-here
# JWT_SECRET=your-jwt-secret-here
# SESSION_SECRET=your-session-secret-here

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL=info

# =============================================================================
# CUSTOM APPLICATION VARIABLES
# =============================================================================
# Add your app-specific variables here

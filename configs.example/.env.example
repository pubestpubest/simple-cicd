# Docker Compose Environment Variables
# Copy this to your app directory as .env and customize
# Docker Compose automatically loads .env files

# =============================================================================
# DOCKER COMPOSE CONFIGURATION
# =============================================================================

# Docker image from DockerHub (built by GitHub Actions)
DOCKER_IMAGE=your-dockerhub-username/your-app-name

# Container name for the main web service
DOCKER_CONTAINER_NAME=web-app

# Project name - used as prefix for containers, networks, and volumes
# Without explicit container_name, containers will be named: ${COMPOSE_PROJECT_NAME}_servicename_1
COMPOSE_PROJECT_NAME=myapp

# =============================================================================
# DATABASE CONFIGURATION (for multi-container setups)
# =============================================================================

# PostgreSQL settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=myapp

# =============================================================================
# APPLICATION ENVIRONMENT (loaded via .env.docker)
# =============================================================================
# Note: App-specific variables should go in .env.docker
# This file (.env) is for Docker Compose variables only
